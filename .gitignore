# Secrets — NEVER commit. (This app stores API keys in SQLite via the UI, not here.)
.env
.env.*
!.env.example
*.key
wallet.json
burner*.json

# Node
node_modules/
dist/
*.log
npm-debug.log*

# Local data — ignore SQLite DBs + runtime caches, but KEEP the JSON seed files
# (data/narratives.json, data/known-memes.json) that the app loads at runtime.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/*.sqlite*
data/seen-tokens.json
ruvector.db

# Local UI-verification harness output (seed-and-serve / run-local-council / shoot)
.verify-data*/

# OS
Thumbs.db
.DS_Store

# ruflo / agentdb runtime artifacts
agentdb.rvf
agentdb.rvf.lock
ruvector.db

# AI Computer screenshot evidence (runtime data)
data/evidence/

# Generated reasoning transcript (runtime data)
transcript*.txt

# ── AI Meme-Coin Sniper — bootstrap config ───────────────────────────────────
# Copy to ".env" to override the built-in defaults below. This file is OPTIONAL:
# everything that matters (wallet address, API keys, risk thresholds, paper
# trading, learning mode) is configured in the dashboard Settings tab and stored
# locally in SQLite — NOT here.
#
# This app is a READ-ONLY signal engine. It never holds a private key, never
# signs, never sends a transaction. There is intentionally NO PRIVATE_KEY here.

# Local dashboard bind. Defaults to 127.0.0.1:3000 (localhost only).
PORT=3000
HOST=127.0.0.1

# Solana RPC. The public endpoint works but is heavily rate-limited; for serious
# use paste a free Helius/QuickNode/Alchemy URL here OR add a Helius key in the UI.
RPC_URL=https://api.mainnet-beta.solana.com

# PumpPortal free realtime data websocket (new tokens + trades).
PUMPPORTAL_WS=wss://pumpportal.fun/api/data

# Where the SQLite database + JSON data files live (default: ./data).
DATA_DIR=data
